{
  "name": "football",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/db/migrations.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:staging": "tsx src/release/staging-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:cleanup-auth": "tsx src/db/cleanup-auth.ts",
    "db:verify-restore": "tsx src/db/verify-restore.ts",
    "db:sync-nflverse": "tsx src/db/sync-nflverse.ts",
    "db:sync-mfl": "tsx src/db/sync-mfl.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.6.25",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
